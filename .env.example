# API key for the OpenAI-compatible gateway.
# Experiential Labs keys come from https://platform.experientiallabs.ai/settings/api-keys
OPENAI_API_KEY=your-api-key-here

# Any OpenAI-compatible endpoint. Defaults to Experiential Labs.
# OPENAI_BASE_URL=https://api.experientiallabs.ai/v1

# Model slug to request. See the gateway's GET /v1/models for what it serves.
# OPENAI_MODEL=qwen3.8-27b

# Total screenings per day across all visitors, so a public demo running on a
# personal key can't be drained. Defaults to 100.
# DAILY_SCREENING_LIMIT=100
